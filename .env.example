# Application
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=config-change-monitor
SCHEMA_VERSION=1.0

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ccm
POSTGRES_USER=ccm
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://ccm:change-me-postgres@postgres:5432/ccm

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ccm
RABBITMQ_PASSWORD=change-me-rabbit
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=ccm.events
RABBITMQ_QUEUE=ccm.notifications
RABBITMQ_DLQ=ccm.notifications.dlq
RABBITMQ_OUTBOX_QUEUE=ccm.outbox.publish

# Redis (optional)
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# PHP API
PHP_API_PORT=8080
API_AUTH_MODE=api_key
API_KEYS=dev-admin-key:admin:default,dev-tenant-a:operator:tenant-a,dev-tenant-b:operator:tenant-b
DEFAULT_TENANT_ID=default
ALLOW_LOCAL_DEV_AUTH=true

# Watcher
WATCH_ALLOWLIST=/watched
EMIT_INITIAL_SNAPSHOT_EVENTS=false
DEBOUNCE_MS=400
STABLE_FILE_MS=250
WATCHER_LEASE_SECONDS=15
WATCHER_CONCURRENCY=32
POLL_FALLBACK_SECONDS=30

# Webhooks
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_BACKOFF_MS=500
WEBHOOK_MAX_BACKOFF_MS=30000
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=30
CONSUMER_PREFETCH=16

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=config-change-monitor

# Prometheus
METRICS_PORT=9100
PHP_METRICS_PORT=9101

# Redaction
REDACTION_KEY_PATTERNS=password,secret,token,api[_-]?key,credential,connection[_-]?string,private[_-]?key,passwd,auth
