{
  "name": "ccm/php-api",
  "description": "Configuration Change Monitor management API",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.4"
  },
  "autoload": {
    "psr-4": {
      "Ccm\\": "src/"
    },
    "classmap": [
